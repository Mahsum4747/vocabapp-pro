rules_version = '2';

// Firestore security rules for vocabapp-pro.
//
// This app never talks to Firestore from the browser: the Firebase JS SDK is
// never initialized client-side, and every read/write goes through a server
// function (src/lib/study-sets.ts, streak.ts) that authenticates the caller
// with this app's own auth (Better Auth) and then uses the Admin SDK — which
// bypasses these rules entirely.
//
// So these rules govern only OTHER access paths, and for those the answer is
// always no. `request.auth` is null in this app's browser sessions anyway
// (there is no Firebase Auth session), so a permissive rule here would be an
// open door rather than a convenience: anyone could read or rewrite another
// user's sets and learning history straight from the public Firebase config.
//
// Collections this covers today:
//   study_sets/{setId}                     — sets and their cards
//   user_streaks/{userId}                  — streak counters
//   ai_generated_sets/{cacheKey}           — Gemini response cache
//   users/{userId}                         — profile: daily goal, timezone, XP
//                                            totals, and `achievements`, a map
//                                            of unlocked id -> epoch ms:
//                                            streak_7, perfect_run,
//                                            mastered_10, set_completed;
//                                            plus `completedSets` (paid-once
//                                            set bonuses) and `soundSettings`
//   users/{userId}/cardProgress/{cardId}   — per-card review summary
//   users/{userId}/reviewEvents/{eventId}  — raw review event log
//   users/{userId}/dailyStats/{date}       — per-day totals
//
// Deny-by-default covers new collections too, so a future feature can't
// accidentally ship readable without this file being updated on purpose.
//
// Mirrors the posture already documented in storage.rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
