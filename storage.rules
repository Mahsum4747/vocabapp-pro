rules_version = '2';

// Firebase Storage security rules for vocabapp-pro.
//
// The app never talks to Firebase Storage from the client — uploads go
// through the `uploadCardImage` server function (src/lib/card-images.ts),
// which authenticates the caller via this app's own auth (Better Auth) and
// then writes with the Admin SDK, which bypasses these rules entirely.
// Reads happen via the download-token URL Firebase issues at upload time
// (`...?alt=media&token=...`), which also bypasses these rules by design —
// that's how the app can render images in a plain <img> tag without a
// Firebase Auth session in the browser.
//
// These rules exist as defense in depth against any OTHER access path: the
// Firebase JS SDK is never initialized client-side in this app, so
// request.auth is always null there, making every rule below deny in
// practice. Kept explicit (rather than a blanket deny) so intent is clear
// if a client SDK / Firebase Auth integration is ever added later.
service firebase.storage {
  match /b/{bucket}/o {
    match /card-images/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
